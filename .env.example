# ── Frontend (Vite) — ค่าเหล่านี้ public ได้ ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Backend (Vercel serverless functions) — ห้าม expose ──
# Service account JSON ทั้งก้อน (Firebase Console > Project settings > Service accounts > Generate new private key)
FIREBASE_ADMIN_KEY={"type":"service_account",...}

# ตั้งเอง สุ่ม string ยาวๆ ใช้เทียบตอน cron ยิงเข้ามา
CRON_SECRET=

# อีเมล Google ที่อนุญาตให้เรียก API ได้ (คั่นด้วย comma ถ้ามีหลายคน) — เว้นว่างได้แต่ไม่แนะนำ
ALLOWED_EMAILS=owner@example.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# ตั้งเอง สุ่ม string ใช้ตอน setWebhook (secret_token) กัน webhook ปลอม
TELEGRAM_WEBHOOK_SECRET=

# URL จริงของเว็บหลัง deploy แล้ว ใช้ในปุ่ม "เปิด Dashboard" บน Telegram
PUBLIC_APP_URL=https://your-app.vercel.app
